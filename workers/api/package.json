{
  "name": "@blehprint/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/state",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit",
    "cf:typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@blehprint/auth": "workspace:*",
    "@blehprint/database": "workspace:*",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.130.0"
  }
}
